{
  "sts": {
    "tokenDuration": "1h",
    "maxSessionLength": "12h",
    "issuer": "seaweedfs-sts",
    "signingKey": "@@STS_SIGNING_KEY@@"
  },
  "providers": [
    {
      "name": "actana-panel",
      "type": "oidc",
      "enabled": true,
      "config": {
        "issuer": "@@OIDC_ISSUER@@",
        "clientId": "@@OIDC_AUDIENCE@@",
        "jwksUri": "@@OIDC_JWKS_URL@@",
        "claimsMapping": {
          "username": "sub"
        },
        "roleMapping": {
          "rules": [],
          "defaultRole": "arn:aws:iam::role/ActanaCoreShared"
        }
      }
    }
  ],
  "policy": {
    "defaultEffect": "Deny"
  },
  "roles": [
    {
      "roleName": "ActanaCoreShared",
      "roleArn": "arn:aws:iam::role/ActanaCoreShared",
      "trustPolicy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "actana-panel"
            },
            "Action": [
              "sts:AssumeRoleWithWebIdentity"
            ]
          }
        ]
      },
      "attachedPolicies": [
        "ActanaCoreOwnPrefix"
      ],
      "description": "A Core: read and write its own Shared folder prefix and nothing else"
    }
  ],
  "policies": [
    {
      "name": "ActanaCoreOwnPrefix",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "ObjectsUnderOwnPrefix",
            "Effect": "Allow",
            "Action": [
              "s3:GetObject",
              "s3:PutObject",
              "s3:DeleteObject",
              "s3:AbortMultipartUpload",
              "s3:ListMultipartUploadParts"
            ],
            "Resource": [
              "arn:aws:s3:::@@BUCKET@@/@@PREFIX@@/${jwt:sub}/*"
            ]
          },
          {
            "Sid": "ListOwnPrefixOnly",
            "Effect": "Allow",
            "Action": [
              "s3:ListBucket",
              "s3:ListBucketMultipartUploads"
            ],
            "Resource": [
              "arn:aws:s3:::@@BUCKET@@"
            ],
            "Condition": {
              "StringLike": {
                "s3:prefix": [
                  "@@PREFIX@@/${jwt:sub}/*"
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
