# Copy to .env next to docker-compose.yml. Everything in it is optional —
# `docker compose up -d` works with no .env at all.
#
# The one value most deployments do change, ACTANA_PUBLIC_HOST, is deliberately
# not here: it belongs in docker-compose.yml beside the Core service it names,
# because a second Core needs a second one and an env file has room for one.

# Optional: the image tag BOTH services pull. Empty means `latest`, the
# current release. Set it to a version (`0.1.0`) to pin a deployment, or to the
# open train's beta (`beta-0.2.0`) to run what is about to ship.
#
# One variable rather than two on purpose: the Panel and its Cores are
# version-locked — the core-link handshake exchanges a protocol version, and a
# mismatched pair renders as "needs update" — so moving one without the other
# is a combination that never shipped.
ACTANA_TAG=

# Optional: the Docker Hub namespace both images come from. Empty means
# `actana`. For a fork publishing under its own account; most deployments never
# touch this. Pre-merge pull request images are in *different repositories*
# rather than a different namespace — see docker-compose.dev-images.yml.
ACTANA_IMAGE_NAMESPACE=

# Required: the password of the bundled Postgres, which holds the Panel's state
# (#567). Left empty, `docker compose up` stops and asks for it: there is no default.
# Generate: `openssl rand -hex 24`. Hex on purpose: it goes into a URL, and a
# password with `@`, `/` or `:` in it would break that URL unless encoded.
# Never commit this file. Changing it later does not change the password inside
# an existing postgres-data volume; change it there too (ALTER USER).
AC_PANEL_DB_PASSWORD=

# Optional: a Postgres of your own instead of the bundled one, as a URL:
# postgres://user:password@host:5432/dbname. Empty means the bundled Postgres.
# The Panel refuses to start when it cannot connect.
AC_PANEL_DATABASE_URL=

# Optional: a 32-byte key (hex or base64) sealing each Core's stored
# credentials, e.g. from `openssl rand -hex 32`. Set it to keep the key out
# of the data volume (and out of volume backups); leave it empty and the
# Panel generates one at /data/secrets.key on first boot. Losing whichever
# key is in use means re-pairing every Core.
AC_SECRETS_KEY=

# Optional: set to 0 (or false/off) to stop the daily release check. Once a day
# the Panel and each Core ask
# https://api.github.com/repos/actana/control/releases/latest whether a newer
# release exists and say so — in a dismissible banner, in `actana status`, and
# in the Core's log. Nothing is ever downloaded or applied: updating stays
# `docker compose pull && docker compose up -d` on this host.
ACTANA_UPDATE_CHECK=

# ── Optional: SeaweedFS for the Shared folder (#566) ─────────────────────────
#
# Only read when you opt in with `docker compose --profile seaweedfs up -d`.
# A plain `docker compose up -d` ignores every variable below. With the profile
# on, the service refuses to start on an empty value (except those that say
# "Empty means") or one that still says `change-me`. Keep this file out of git.
#
# The S3 admin key pair the Panel's key issuer uses to manage the bucket. Cores
# never get it. Generate: `openssl rand -hex 12` and `openssl rand -hex 24`.
SEAWEEDFS_S3_ADMIN_ACCESS_KEY=
SEAWEEDFS_S3_ADMIN_SECRET_KEY=
# The key SeaweedFS signs its STS session tokens with: base64 of at least 32
# random bytes. Generate: `openssl rand -base64 32`. Changing it ends every
# session in flight.
SEAWEEDFS_STS_SIGNING_KEY=
# The Panel's token signer, as SeaweedFS should trust it: the `iss` the Panel
# puts in the tokens it issues to Cores, and the URL of the key set that
# verifies them. SeaweedFS fetches the JWKS URL itself, so it must be an address
# the seaweedfs container can reach (not `localhost`).
SEAWEEDFS_OIDC_ISSUER=
SEAWEEDFS_OIDC_JWKS_URL=
# The `aud` the Panel's tokens carry. Empty means `actana-shared`.
SEAWEEDFS_OIDC_AUDIENCE=
# The bucket and the path inside it that hold the Cores' folders; a Core gets
# `<bucket>/<prefix>/<core-id>/`. Empty means `actana-shared` and `cores`.
SEAWEEDFS_BUCKET=
SEAWEEDFS_PREFIX=
