# Copy to .env next to docker-compose.yml. Everything in it is optional —
# `docker compose up -d` works with no .env at all.
#
# The one value most deployments do change, ACTANA_PUBLIC_HOST, is deliberately
# not here: it belongs in docker-compose.yml beside the Core service it names,
# because a second Core needs a second one and an env file has room for one.

# Optional: a 32-byte key (hex or base64) sealing each Core's stored
# credentials, e.g. from `openssl rand -hex 32`. Set it to keep the key out
# of the data volume (and out of volume backups); leave it empty and the
# Panel generates one at /data/secrets.key on first boot. Losing whichever
# key is in use means re-pairing every Core.
AC_SECRETS_KEY=

# Optional: set to 0 (or false/off) to stop the daily release check. Once a day
# the Panel and each Core ask
# https://api.github.com/repos/actana/control/releases/latest whether a newer
# release exists and say so — in a dismissible banner, in `actana status`, and
# in the Core's log. Nothing is ever downloaded or applied: updating stays
# `docker compose pull && docker compose up -d` on this host.
ACTANA_UPDATE_CHECK=
