#!/bin/sh
# Refuses a commit whose message breaks commitlint.config.mjs — the same rules,
# from the same script, that the Conventions job in ci.yml enforces (#614).
#
# Installed by `pnpm install` (the `prepare` script sets core.hooksPath).

root="$(git rev-parse --show-toplevel)" || exit 1

sh "$root/scripts/check-conventions.sh" message "$1" && exit 0
status=$?

if [ "$status" -eq 1 ]; then
  echo "commit-msg: refused — this message breaks the Conventional Commits rules in commitlint.config.mjs (listed above); fix it and commit again." >&2
fi
exit "$status"
