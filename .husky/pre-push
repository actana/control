#!/bin/sh
# Refuses a push whose branch name or new commits break the repo's conventions,
# using the same script as the Conventions job in ci.yml (#614). A pushed
# commit can never be rewritten, so this is the last cheap place to catch one.
#
# git hands us one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

root="$(git rev-parse --show-toplevel)" || exit 1
check="$root/scripts/check-conventions.sh"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deletions and tags carry no branch name or commits to check.
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  branch="${remote_ref#refs/heads/}"
  if ! sh "$check" branch "$branch"; then
    echo "pre-push: refused — branch '$branch' is not <type>/<kebab-case-description>; rename it with 'git branch -m <new-name>' and push again." >&2
    failed=1
    continue
  fi

  # Lint only the commits no remote has — for an update and for a new branch
  # alike. CI lints BASE_SHA..HEAD_SHA, which never holds the base's own
  # commits, so a branch that merged the base in must not be asked about them.
  # Merge commits are skipped: git writes their messages, commitlint ignores them.
  known="--remotes"
  case "$remote_sha" in
    *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && known="--remotes $remote_sha" ;;
  esac
  status=0
  # shellcheck disable=SC2086 # $known is two words on purpose
  for sha in $(git rev-list --reverse --no-merges "$local_sha" --not $known); do
    sh "$check" commit "$sha" || status=1
  done
  if [ "$status" -ne 0 ]; then
    echo "pre-push: refused — a commit being pushed to '$branch' breaks the commit rules in commitlint.config.mjs (listed above); reword it before pushing, because a pushed commit can never be rewritten." >&2
    failed=1
  fi
done

exit "$failed"
