# Pinned Node runtimes downloaded by `pnpm core:tarball`.
.cache/

.openai-key
.license-key

# Local dev SQLite store + app state (isolated from the installed app's DB)
.dev-userdata/

# Bundled whisper.cpp voice-control artifacts (fetched via `pnpm setup:whisper`).
# Large binaries/model are not committed; the directory scaffold + docs are.
resources/whisper/*
!resources/whisper/.gitkeep
!resources/whisper/README.md

# Actana Control Recall (project memory) — private, do not commit
CLAUDE.local.md
# Actana Control Recall (code graph MCP) — machine-specific, regenerated per session
.mcp.json

# Grok goal scratch dirs (local agent workspaces)
Temp/
**/grok-goal-*/

# Local git worktrees created by Actana Control
.worktree/

# Checkouts the reference compose bind-mounts into the Core (deploy/docker-compose.yml).
# The directory is checked in so a clean checkout can `docker compose up` with
# no root-owned mountpoint appearing under it; its contents are yours.
deploy/repos/*
!deploy/repos/.gitkeep

# Vendor font binaries for `docs/assets/src/build.mjs` (OFL-1.1, not ours to
# redistribute) and the stale output dir the script used to write to.
docs/assets/src/fonts/
docs/assets/src/out/
