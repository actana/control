{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": false,
    // Allowed for what this compiler now reads, not for what the Panel writes:
    // `@actana/sdk` is the published package, resolved from `node_modules`
    // through its exports map, and the `.d.ts` files it ships import each other
    // with the `.ts` extension (it is built with rewritten relative imports).
    // Type-checking them needs this flag. Safe for the same reason as in the
    // other packages: `noEmit`, and Vite resolves the specifiers.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@actana/shared/*": ["../shared/src/*"],
      "@actana/core/*": ["../core/src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*", "vite.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", ".output"]
}
