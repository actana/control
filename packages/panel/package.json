  "version": "0.49.0",
  "description": "Actana Control Panel — service + UI (TanStack Start SSR server and the browser app).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "actana-panel": "bin/panel.mjs"
  },
  "scripts": {
