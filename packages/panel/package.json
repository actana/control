{
  "name": "@actana/panel",
  "version": "0.5.0",
  "description": "Actana Control Panel — service + UI (TanStack Start SSR server and the browser app).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "actana-panel": "bin/panel.mjs"
  },
  "scripts": {
    "generate:routes": "node scripts/generate-routes.mjs",
    "start": "node bin/panel.mjs",
    "dev": "vite --strictPort",
    "build": "vite build",
    "typecheck": "pnpm generate:routes && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@actana/sdk": "0.5.0",
    "@actana/shared": "workspace:*",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.0",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-with-query": "1.130.17",
    "@tanstack/react-start": "1.167.65",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.10.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.16.0",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0",
    "sonner": "2.0.7",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@actana/core": "workspace:*",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/router-plugin": "1.168.19",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.8.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.0.13",
    "vitest": "4.1.6"
  }
}
