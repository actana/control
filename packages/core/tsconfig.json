{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    // Bundler, not Node: `@actana/sdk` is consumed from npm through its `exports`
    // map, which the classic Node resolution does not read. Nothing is emitted
    // from this program (`noEmit`); esbuild bundles the Core.
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Core reaches its workspace siblings by package name, never by relative
    // path (ADR 0016 D3): the declared dependency is the boundary, and a bundle
    // that inlines the source is an implementation detail rather than the
    // contract. Mirrors the Panel's mapping.
    //
    // `@actana/sdk` is the published package from actana/client, pinned exactly
    // in `package.json`; it holds the core-link frames and the pairing server
    // (ADR 0025), and is not mapped here.
    "baseUrl": ".",
    "paths": {
      "@actana/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
