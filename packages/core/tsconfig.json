{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Core reaches `packages/shared` by package name, never by relative path
    // (ADR 0016 D3): the declared `@actana/shared` dependency is the boundary,
    // and a bundle that inlines the source is an implementation detail rather
    // than the contract. Mirrors the Panel's mapping.
    "baseUrl": ".",
    "paths": {
      "@actana/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
