{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Relative imports carry their `.ts` extension, matching `packages/sdk` —
    // the specifiers this package writes are the ones the SDK's own source
    // writes, so a file can move between the two without a rewrite.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@actana/sdk/*": ["../sdk/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
