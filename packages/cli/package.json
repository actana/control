{
  "name": "@actana/core-cli",
  "private": true,
  "version": "0.5.0",
  "description": "The built-in `actana` of a Core: the machine verbs (install, setup, status, daemon, pair), with the client nouns handed to the published @actana/cli.",
  "license": "MIT",
  "type": "module",
  "keywords": ["actana", "cli", "agent", "terminal", "core-link"],
  "homepage": "https://github.com/actana/control/tree/main/packages/cli#readme",
  "bugs": "https://github.com/actana/control/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/control.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "bin"],
  "bin": {
    "actana": "bin/actana.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actana/cli": "0.6.0-next.10",
    "@actana/sdk": "0.6.0-next.4",
    "selfsigned": "^5.5.0",
    "undici": "8.10.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
