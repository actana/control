{
  "name": "@actana/cli",
  "version": "0.4.1",
  "description": "Actana Control CLI — the `actana` command: install and operate a Core on this machine, and drive Cores anywhere from the client nouns built on @actana/sdk.",
  "license": "MIT",
  "type": "module",
  "keywords": ["actana", "cli", "agent", "terminal", "core-link"],
  "homepage": "https://github.com/actana/control/tree/main/packages/cli#readme",
  "bugs": "https://github.com/actana/control/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actana/control.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22"
  },
  "files": ["dist", "bin"],
  "bin": {
    "actana": "bin/actana.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actana/sdk": "workspace:*",
    "selfsigned": "^5.5.0",
    "undici": "8.9.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
