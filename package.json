{
  "name": "actana-control",
  "version": "0.49.0",
  "description": "Actana Control \u2014 self-hosted Panel service for driving AI coding agents across many Cores.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "check:node": "node scripts/require-node-24.mjs",
    "preinstall": "node scripts/require-node-24.mjs",
    "predev": "node scripts/require-node-24.mjs",
    "prestart": "node scripts/require-node-24.mjs",
    "prebuild": "node scripts/require-node-24.mjs",
    "pregenerate:routes": "node scripts/require-node-24.mjs",
    "pretypecheck": "node scripts/require-node-24.mjs",
    "prelint": "node scripts/require-node-24.mjs",
    "pretest": "node scripts/require-node-24.mjs",
    "prescan:secrets": "node scripts/require-node-24.mjs",
    "predb:generate": "node scripts/require-node-24.mjs",
    "predb:push": "node scripts/require-node-24.mjs",
    "prenative:node": "node scripts/require-node-24.mjs",
    "prenative:node:rebuild": "node scripts/require-node-24.mjs",
    "preharness:tarball": "node scripts/require-node-24.mjs",
    "preharness:tarball:smoke": "node scripts/require-node-24.mjs",
    "prepanel:e2e": "node scripts/require-node-24.mjs",
    "prepanel:image:smoke": "node scripts/require-node-24.mjs",
    "preharness:setup:e2e": "node scripts/require-node-24.mjs",
    "preharness:setup:e2e:macos": "node scripts/require-node-24.mjs",
    "preharness:install:e2e": "node scripts/require-node-24.mjs",
    "preharness:agents:e2e": "node scripts/require-node-24.mjs",
    "preharness:rehearse": "node scripts/require-node-24.mjs",
    "prefixture:release": "node scripts/require-node-24.mjs",
    "dev": "pnpm --filter @actana/panel dev",
    "start": "pnpm --filter @actana/panel start",
    "build": "pnpm --filter @actana/harness build && pnpm --filter @actana/panel build",
    "generate:routes": "pnpm --filter @actana/panel generate:routes",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages scripts screenshot.mjs eslint.config.mjs",
    "test": "pnpm native:node && vitest run && pnpm -r test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "db:generate": "pnpm native:node && pnpm --filter @actana/panel db:generate",
    "db:push": "pnpm native:node && pnpm --filter @actana/panel db:push",
    "native:node": "node scripts/ensure-node-sqlite.mjs",
    "native:node:rebuild": "pnpm rb better-sqlite3",
    "panel:e2e": "pnpm --filter @actana/harness build && pnpm --filter @actana/panel build && node scripts/e2e-panel-smoke.mjs",
    "panel:image:smoke": "node scripts/smoke-panel-image.mjs",
    "harness:tarball": "pnpm --filter @actana/harness build && node scripts/build-harness-tarball.mjs",
    "harness:tarball:smoke": "node scripts/smoke-harness-tarball.mjs",
    "harness:setup:e2e": "node scripts/e2e-actana-setup-linux.mjs",
    "harness:setup:e2e:macos": "node scripts/e2e-actana-setup-macos.mjs",
    "harness:install:e2e": "node scripts/e2e-install-sh-linux.mjs",
    "harness:agents:e2e": "node scripts/e2e-actana-agents-linux.mjs",
    "harness:rehearse": "node scripts/rehearse-install.mjs",
    "fixture:release": "node scripts/fixture-release-server.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@actana/harness": "workspace:*",
    "@actana/panel": "workspace:*",
    "@actana/shared": "workspace:*",
    "better-sqlite3": "12.10.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "eslint": "10.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "puppeteer": "25.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "protobufjs"
    ]
  }
}
