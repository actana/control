{
  "name": "Trains — beta/*",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 0,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/beta/**"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Conventions", "integration_id": 15368 },
          { "context": "Train rules", "integration_id": 15368 },
          { "context": "Typecheck", "integration_id": 15368 },
          { "context": "Unit Tests", "integration_id": 15368 },
          { "context": "Lint", "integration_id": 15368 },
          { "context": "Secret Scan", "integration_id": 15368 },
          { "context": "Dependency Audit", "integration_id": 15368 },
          { "context": "Panel image / Resolve registries", "integration_id": 15368 },
          { "context": "Panel image / Build + smoke (amd64)", "integration_id": 15368 },
          { "context": "Core image / Resolve registries", "integration_id": 15368 },
          { "context": "Core image / Build + smoke (amd64)", "integration_id": 15368 }
        ]
      }
    }
  ]
}
